@page "/files"

<link href="/css/styles.css" rel="stylesheet" type="text/css">

@attribute [Authorize]
@attribute [StreamRendering]

@inject NavigationManager _navigationManager
@inject HttpClient httpClient
@inject AuthenticationStateProvider AuthenticationStateProvider

@using Microsoft.AspNetCore.Authorization;
@using MedicalExaminationPreliminaryLists.Share.DTOs
@using MedicalExaminationPreliminaryLists.Data.Models
<PageTitle>Загруженные файлы</PageTitle>

<h1>Загруженные файлы</h1>

@if (!files.Any())
{
    <p><em>Загрузка...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Название файла</th>
                <th>Дата загрузки</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in files)
            {
                <tr>
                    <td>@file.FileName</td>
                    <td>@file.UploadDate</td>
                    <td>
                        <a href="/zaps/@file.Id" class="btn btn-outline-primary">
                            <i class="bi bi-file-text me-1"></i>Открыть содержимое
                        </a>
                    </td>
                    <td>
                        @if (userRole == "Admin")
                        {
                            <button type="button" class="btn btn-danger" @onclick="@(async ()=> await Delete(file.Id))">Удалить</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    <p>
        <label class="btn btn-primary">
            Выбрать файл
            <InputFile OnChange="HandleSelectedFile" class="form-control-file" style="display: none;" />
        </label>
    </p>

    @if (selectedFile != null)
    {
        <p><strong>Выбран файл:</strong> @selectedFile.Name</p>
    }

    <p>
        <button @onclick="()=>UploadFile()" class="btn btn-success" disabled="@(selectedFile == null)">Загрузить файл</button>
    </p>
</div>

@if (!string.IsNullOrEmpty(uploadStatusMessage))
{
    <div class="alert @statusClass">@((MarkupString)uploadStatusMessage)</div>
}

@code {
    List<UploadFileModel> files = [];
    UploadFileModel fileDTO = new();
    private IBrowserFile? selectedFile;

    private string userRole = string.Empty;
    private string uploadStatusMessage = string.Empty;
    private string statusClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("Admin"))
        {
            userRole = "Admin";
        }
        else
        {
            userRole = "User";
        }
        await LoadData();
    }


    async Task LoadData()
    {
        fileDTO.Id = Guid.Empty;
        files = await httpClient.GetFromJsonAsync<List<UploadFileModel>>($"{httpClient.BaseAddress}/UploadFiles") ?? files;
    }

    async Task Delete(Guid id)
    {
        await httpClient.DeleteAsync($"{httpClient.BaseAddress}/UploadFiles/{id}");
        await LoadData();
    }

    private void HandleSelectedFile(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    async Task UploadFile()
    {
        if (selectedFile is not null)
        {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(selectedFile.OpenReadStream());
            content.Add(fileContent, "file", selectedFile.Name);
            var response = await httpClient.PostAsync("https://localhost:7112/api/v1/MedicalExaminationPreliminaryLists/upload", content);

            if (response.IsSuccessStatusCode)
            {
                uploadStatusMessage = "Файл успешно загружен.";
                statusClass = "alert-success";
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                uploadStatusMessage = errorMessage.Replace("\n", "<br>");
                statusClass = "alert-danger";
            }

            selectedFile = null;
            await LoadData();
        }
    }
}
