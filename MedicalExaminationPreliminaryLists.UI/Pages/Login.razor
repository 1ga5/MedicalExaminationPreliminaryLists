@page "/login"
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IConfiguration Configuration
@inject NavigationManager _navigationManager

@using MedicalExaminationPreliminaryLists.Share.DTOs

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card" style="width: 100%; max-width: 400px;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Вход</h3>
            <EditForm Model="loginModel" OnSubmit="HandleLogin">
                <div class="form-group mb-3">
                    <label for="username">Имя пользователя</label>
                    <InputText id="username" class="form-control" @bind-Value="loginModel.Username" placeholder="Введите имя пользователя" />
                </div>
                <div class="form-group mb-3">
                    <label for="password">Пароль</label>
                    <InputText id="password" class="form-control" @bind-Value="loginModel.Password" type="password" placeholder="Введите пароль" />
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Войти</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    LoginModel loginModel = new LoginModel();
    async Task HandleLogin()
    {
        var result = await Http.PostAsJsonAsync($"https://localhost:7112/api/Authentication/login", loginModel);
        if (result.IsSuccessStatusCode)
        {
            var token = await result.Content.ReadAsStringAsync();

            await LocalStorage.SetItemAsync("token", token);
            await AuthStateProvider.GetAuthenticationStateAsync();

            _navigationManager.NavigateTo("");
        }
    }
}