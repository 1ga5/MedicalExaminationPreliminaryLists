@page "/dn/change/{DispensaryObservationId:int}"

@using Microsoft.AspNetCore.Authorization;
@using MedicalExaminationPreliminaryLists.Share.DTOs

@attribute [Authorize(Roles = "Admin")]
@attribute [StreamRendering]

@inject HttpClient httpClient
@inject NavigationManager _navigationManager


<PageTitle>Изменить запись</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">Изменить запись</h3>
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-body">
                    <form @onsubmit="Submit">
                        <div class="mb-3">
                            <label for="number" class="form-label">Порядковый номер</label>
                            <input id="number" class="form-control" @bind-value="dn.Number" />
                        </div>
                        <div class="mb-3">
                            <label for="medProfileId" class="form-label">Id профиля медицинской помощи</label>
                            <input id="medProfileId" class="form-control" @bind-value="dn.MedProfileId" />
                        </div>
                        <div class="mb-3">
                            <label for="lpuType" class="form-label">Код лечебно-профилактического учреждения</label>
                            <input id="lpuType" class="form-control" @bind-value="dn.LpuType" />
                        </div>
                        <div class="mb-3">
                            <label for="diagnosisId" class="form-label">Код МКБ</label>
                            <input id="diagnosisId" class="form-control" @bind-value="dn.DiagnosisId" />
                        </div>
                        <div class="mb-3">
                            <label for="beginDate" class="form-label">Дата начала</label>
                            <input id="beginDate" type="date" class="form-control" @bind-value="dn.BeginDate" />
                        </div>
                        <div class="mb-3">
                            <label for="endDate" class="form-label">Дата конца</label>
                            <input id="endDate" type="date" class="form-control" @bind-value="dn.EndDate" />
                        </div>
                        <div class="mb-3">
                            <label for="endReason" class="form-label">Причина прекращения</label>
                            <input id="endReason" class="form-control" @bind-value="dn.EndReason" />
                        </div>
                        <div class="mb-3 text-center">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int DispensaryObservationId { get; set; }

    DispensaryObservationModel dn = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        dn = await httpClient.GetFromJsonAsync<DispensaryObservationModel>($"{httpClient.BaseAddress}/DispensaryObservations/{DispensaryObservationId}") ?? dn;
    }

    async Task Submit()
    {
        await httpClient.PutAsJsonAsync($"{httpClient.BaseAddress}/DispensaryObservations/{DispensaryObservationId}", dn);
        
        var zap = await httpClient.GetFromJsonAsync<ZAPMainRecordModel>($"{httpClient.BaseAddress}/Zaps/{dn.ZAPMainRecordId}");
        _navigationManager.NavigateTo($"zaps/{zap.UploadFileId}");
        await LoadData();
    }
}

