@page "/zap/change/{ZapId:guid}"

@using Microsoft.AspNetCore.Authorization;
@using MedicalExaminationPreliminaryLists.Share.DTOs

@attribute [Authorize(Roles = "Admin")]
@attribute [StreamRendering]

@inject HttpClient httpClient
@inject NavigationManager _navigationManager


<PageTitle>Изменить запись</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">Изменить запись</h3>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form @onsubmit="Submit">
                        <div class="mb-2">
                            <label for="zapNumber" class="form-label">Порядковый номер</label>
                            <input id="zapNumber" class="form-control form-control-sm" @bind-value="zap.ZAPNumber" />
                        </div>
                        <div class="mb-2">
                            <label for="year" class="form-label">Год</label>
                            <input id="year" type="number" class="form-control form-control-sm" @bind-value="zap.Year" />
                        </div>
                        <div class="mb-2">
                            <label for="surname" class="form-label">Фамилия</label>
                            <input id="surname" class="form-control form-control-sm" @bind-value="zap.Surname" />
                        </div>
                        <div class="mb-2">
                            <label for="name1" class="form-label">Имя</label>
                            <input id="name1" class="form-control form-control-sm" @bind-value="zap.Name1" />
                        </div>
                        <div class="mb-2">
                            <label for="name2" class="form-label">Отчество</label>
                            <input id="name2" class="form-control form-control-sm" @bind-value="zap.Name2" />
                        </div>
                        <div class="mb-2">
                            <label for="birthday" class="form-label">Дата рождения</label>
                            <input id="birthday" type="date" class="form-control form-control-sm" @bind-value="zap.Birthday" />
                        </div>
                        <div class="mb-2">
                            <label for="telephoneNumber" class="form-label">Телефонный номер</label>
                            <input id="telephoneNumber" class="form-control form-control-sm" @bind-value="zap.TelephoneNumber" />
                        </div>
                        <div class="mb-2 text-center">
                            <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public Guid ZapId { get; set; }

    ZAPMainRecordModel zap = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        zap = await httpClient.GetFromJsonAsync<ZAPMainRecordModel>($"{httpClient.BaseAddress}/Zaps/{ZapId}") ?? zap;
    }

    async Task Submit()
    {
        await httpClient.PutAsJsonAsync($"{httpClient.BaseAddress}/Zaps/{zap.Id}", zap);

        _navigationManager.NavigateTo($"zaps/{zap.UploadFileId}");
        await LoadData();
    }
}

